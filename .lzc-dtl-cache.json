{
  "name": "Domain Admin",
  "package": "cloud.lzaycat.app.domain-admin",
  "description": "域名和SSL证书监测平台",
  "homepage": "https://github.com/dromara/domain-admin",
  "author": "dromara",
  "app_features": [
    "background_task",
    "public_path"
  ],
  "subdomain": "domain-admin",
  "version": "1.6.65",
  "public_paths": [
    "/"
  ],
  "iconPath": "icon.png",
  "composePath": "docker-compose.yml",
  "unsupported_platforms": [
    "ios",
    "android",
    "tvos"
  ],
  "lastRouteType": "from_compose",
  "port_mappings": {
    "domain-admin_8000_8000": {
      "use": true,
      "type": "http",
      "path": "/",
      "targetPath": "/"
    }
  },
  "image_mouday_domain-admin_latest": {
    "originalImage": "mouday/domain-admin:latest",
    "pushTarget": "none"
  },
  "domain-admin_volume_/app/database_action": "emptyDir",
  "domain-admin_volume_/app/database_location": "app_data",
  "domain-admin_volume_/app/logs_action": "emptyDir",
  "domain-admin_volume_/app/logs_location": "app_data"
}
